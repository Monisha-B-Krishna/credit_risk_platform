# The actual .env file is never committed - only this example/template.

# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_api_key_here

# Which Groq-hosted model to call for NL-to-SQL conversion.
# Llama 3.3 70B is free on Groq and strong enough for this task.
LLM_MODEL=openai/gpt-oss-120b

# Folder where the raw Home Credit CSVs live (mounted into the Docker container)
DATA_DIR=/app/data

# Folder where trained model artifacts are saved/loaded from
MODEL_DIR=/app/models

# Port Streamlit runs on inside the container
APP_PORT=8501