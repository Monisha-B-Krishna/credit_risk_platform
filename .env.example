
# API key for the talk-to-data chatbot's LLM.
# Groq is used - free tier, no credit card required, fast enough for
# NL-to-SQL, which needs reliable structured output rather than heavy
# reasoning.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=your_api_key_here

# Groq-hosted model for NL-to-SQL conversion and answer generation.
LLM_MODEL=openai/gpt-oss-120b

# Port Streamlit runs on, both locally and inside the Docker container.
APP_PORT=8501