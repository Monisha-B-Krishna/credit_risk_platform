# Raw dataset excluded from git
data/*.csv

# Model artifacts (credit_risk_model.joblib, feature_columns.json,
# categorical_categories.json) are committed deliberately - they're
# small (a few hundred KB) and let the Docker deployment work
# out-of-the-box without requiring a training run first. This is
# different from the raw dataset, which stays excluded below.

# Python's own clutter
__pycache__/
*.pyc
.ipynb_checkpoints/

# API keys live in .env
.env

# Virtual environment folder
venv/
.venv/